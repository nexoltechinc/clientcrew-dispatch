APP_ENV=development
# Required: PostgreSQL connection string (local example).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dispatch_system
# Hosted Postgres URLs like postgres://... are also accepted and auto-normalized.
# Neon example:
# DATABASE_URL=postgresql://your_user:your_password@your-neon-host/neondb?sslmode=require&channel_binding=require
JWT_SECRET_KEY=change-me-dev-only
JWT_ALGORITHM=HS256
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COMPANY_LOGO_URL=
COMPANY_NAME=DispatchIQ
COMPANY_STREET_ADDRESS=123 Service Lane
COMPANY_CITY=New York
COMPANY_STATE=NY
COMPANY_ZIP_CODE=10001
COMPANY_PHONE=+1-555-010-1000
COMPANY_EMAIL=billing@dispatchiq.test
COMPANY_WEBSITE=https://dispatchiq.test
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=DispatchIQ
PASSWORD_RESET_OTP_TTL_MINUTES=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
ADMIN_EMAIL=nexoltechsolutionsinc@gmail.com
ADMIN_RECOVERY_EMAIL=nexoltechsolutionsinc@gmail.com
ADMIN_DEFAULT_PASSWORD=admin123
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=
QB_ENV=sandbox
QUICKBOOKS_ITEMS_SYNC_INTERVAL_SECONDS=180
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
QUICKBOOKS_WEBHOOK_DEVELOPMENT_VERIFIER_TOKEN=
QUICKBOOKS_WEBHOOK_PRODUCTION_VERIFIER_TOKEN=

